# Port the CRM app listens on (dev and production)
PORT=3879
# Optional: interface to bind (use 0.0.0.0 behind a reverse proxy on another host)
HOST=localhost
# Base URL of the existing Strapi CMS (no trailing slash, no /api), e.g. https://cms-vgad.visiongroup.co.ug
NUXT_STRAPI_URL=https://cms-vgad.visiongroup.co.ug
# 32+ random characters, e.g. `openssl rand -hex 32` — encrypts the crm_session cookie
NUXT_CRM_SESSION_SECRET=7066433c8121d2ba1a41fbd9b51d687e05bf3aa74095f93675e5f3223a357d8e
# 32+ random characters — must equal CRM_GATEWAY_SECRET in the Strapi .env
NUXT_CRM_GATEWAY_SECRET=7066433c8121d2ba1a41fbd9b51d687e05bf3aa74095f93675e5f3223a357d8e
# Module name sent to /api/vgams-users/login (SFA uses 'sfa')
NUXT_VGAMS_MODULE=crm
